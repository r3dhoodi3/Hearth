/dev-server.log
/dev-server.err.log
/prod-server.log
/prod-server.err.log
/build.log
/cf-out.log
/cf-err.log

# local video rollback backups (git history is the real backup once committed)
/demo-video-backup/

# spent one-time SQL apply bundles (canonical migrations live in supabase/migrations/)
/supabase/applied-bundles/

# dated session notes and reports (handoff.md is the tracked, current one)
/handoff-*.md
/MORNING-REPORT-*.md
/MORNING-REPORT-*.pdf

# Claude Code agent worktrees and session files
.claude/
